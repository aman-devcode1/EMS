{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemory": false,
  "CorsSettings": {
    "AllowedOrigins": []
  },
  "JwtSettings": {
    "Issuer": "EMS.API",
    "Audience": "EMS.Frontend",
    "AdminAccessTokenExpiryMinutes": 15,
    "AdminRefreshTokenAbsoluteHours": 8,
    "AdminInactivityTimeoutMinutes": 5,
    "EmployeeAccessTokenExpiryMinutes": 15,
    "EmployeeRefreshTokenAbsoluteHours": 24,
    "EmployeeInactivityTimeoutMinutes": 60,
    "ClockSkewSeconds": 5
  },
  "OtpSettings": {
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5,
    "LogOtpToConsole": false
  },
  "EmailSettings": {
    "ApiUrl": "https://api.brevo.com/v3/smtp/email",
    "ApiKeyHeader": "api-key"
  }
}