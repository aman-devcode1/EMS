    <diagram id="0FXzb833V1lxv_jBbhKc" name="Page-1">
        <mxGraphModel dx="1302" dy="575" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="8" value="Depend On Interfaces" style="edgeStyle=none;html=1;exitX=0.471;exitY=0.007;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;exitPerimeter=0;" parent="1" source="14" target="2" edge="1">
                    <mxGeometry x="-0.381" y="-10" relative="1" as="geometry">
                        <mxPoint x="200" y="309" as="sourcePoint"/>
                        <Array as="points">
                            <mxPoint x="200" y="218"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <object label="&lt;div style=&quot;text-align: center; line-height: 100%;&quot;&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 16px; line-height: 100%;&quot;&gt;&lt;u&gt;Interface(Wrapper of Database)&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;&lt;font&gt;create only those method names and parameters which needs in projects like CRUD operations, Exists or not, validations, search by ids etc.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;एक अनुबंध (Contract) जिसमें मेथड के नाम, पैरामीटर और रिटर्न टाइप लिखे होते हैं — न कोई बॉडी, न कोई लॉजिक।&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" id="2">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;align=left;glass=0;shadow=1;" parent="1" vertex="1">
                        <mxGeometry x="235" y="120" width="380" height="130" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;text-align: center; line-height: 100%;&quot;&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 16px; line-height: 100%;&quot;&gt;&lt;u&gt;Repositiory(Data Access Work)&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;&amp;nbsp;इंटरफ़ेस में जो मेथड सिर्फ़ घोषित (declare) हुआ था, उसकी बॉडी यहाँ लिखी जाती है — &quot;काम कैसे होगा&quot;।&amp;nbsp;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;database se indirectly connection(wrapper or DTO k through) yhi hota hai. jo chahiye hota hai db se yhi se logic through liya jata hai. aur bhi sare basic aur specific operations kiye jate hai.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Write Data (AddAsync)&lt;/li&gt;&lt;li&gt;Read Data (GetByIdAsync,&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;GetByDepartmentAsync, GetPagedAsync)&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;Update Data (UpdateAsync)&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;Delete Data (&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;DeleteAsync&lt;/span&gt;)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;Check Data (ExistsAsync, IsEmailUniqueAsync)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;Count Data (CountAsync)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;LINQ Queries use ki jati hai.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" id="14">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;align=left;glass=0;shadow=1;" parent="1" vertex="1">
                        <mxGeometry x="7" y="310" width="410" height="290" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;text-align: center; line-height: 100%;&quot;&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 16px; line-height: 100%;&quot;&gt;&lt;u&gt;Service&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;&amp;nbsp;yah कंज़्यूमर है जो इंटरफ़ेस के ज़रिए कहती है — “मुझे GetByIdAsync(5) दे दो” — और उसे बस रिज़ल्ट से मतलब है, तरीके से नहीं।&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;font style=&quot;line-height: 110%; color: rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif;&quot;&gt;&quot;क्या करना है और क्यों करना है&quot; — यह सर्विस तय करती है।&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Service ko kabhi direct database aur Repository se connect nhi karte. jo jo database se chahaiye hota hai vo sab Interface mein method k naam likhe jate hai aur Repository mein logic likha jata hai.&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(10, 10, 10); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif;&quot; class=&quot;&quot;&gt;सर्विस का रिज़ल्ट हमेशा &lt;/span&gt;&lt;span style=&quot;font-weight: 600; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif;&quot;&gt;&lt;span class=&quot;&quot;&gt;DTO&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif;&quot; class=&quot;&quot;&gt; होता है — न कि डेटाबेस एंटिटी। इससे कंज़्यूमर को डेटाबेस स्ट्रक्चर से कोई लेना-देना नहीं रहता।&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" id="16">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;align=left;glass=0;shadow=1;" parent="1" vertex="1">
                        <mxGeometry x="540" y="310" width="360" height="210" as="geometry"/>
                    </mxCell>
                </object>
