n style=&quot;color: rgb(183, 107, 1);&quot; class=&quot;token constructor-invocation class-name&quot;&gt;Employee&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;;&lt;/span&gt; &lt;br&gt;emp&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;.&lt;/span&gt;Name &lt;span style=&quot;color: rgb(64, 120, 242);&quot; class=&quot;token operator&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(80, 161, 79);&quot; class=&quot;token string&quot;&gt;&quot;Rahul&quot;&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;;&lt;/span&gt;&lt;/pre&gt;&lt;svg class=&quot;_9bc997d _33882ae&quot; fill=&quot;none&quot; viewBox=&quot;0 0 12 12&quot; height=&quot;12&quot; width=&quot;12&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;path fill=&quot;currentColor&quot; d=&quot;M-5.24537e-07 0C-2.34843e-07 6.62742 5.37258 12 12 12L0 12L-5.24537e-07 0Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;svg class=&quot;_9bc997d _28d7e84&quot; fill=&quot;none&quot; viewBox=&quot;0 0 12 12&quot; height=&quot;12&quot; width=&quot;12&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;path fill=&quot;currentColor&quot; d=&quot;M-5.24537e-07 0C-2.34843e-07 6.62742 5.37258 12 12 12L0 12L-5.24537e-07 0Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/div&gt;&lt;hr style=&quot;background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: none 100% / 1 / 0 stretch; height: 1px; margin: 32px 0px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px;&quot;&gt;&lt;h3 style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 20px; line-height: 30px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(15, 17, 21); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;2️⃣ ऑब्जेक्ट कब बनाते हैं? (और क्यों?)&lt;/span&gt;&lt;/h3&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;हम ऑब्जेक्ट तभी बनाते हैं जब हमें &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Memory (RAM)&lt;/span&gt;&lt;span class=&quot;&quot;&gt; में कोई चीज़ Store करनी होती है, या किसी Function को कुछ Data देना/लेना होता है।&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;अब आते हैं आपके &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;GridView&lt;/span&gt;&lt;span class=&quot;&quot;&gt; वाले उदाहरण पर, जिससे आप पूरी तरह क्लियर हो जाएँगे:&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;margin: 16px 0px; padding-left: 18px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;li&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Database Table:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; आपने Table बनाया क्योंकि आपको Data &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Permanently&lt;/span&gt;&lt;span class=&quot;&quot;&gt; (हमेशा के लिए) Hard Disk पर Save करना था। यह &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;&quot;दीर्घकालिक भंडारण&quot; (Permanent Storage)&lt;/span&gt;&lt;span class=&quot;&quot;&gt; है।&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;C# Object:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; आपको वह Data GridView में दिखाने के लिए &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Database से निकालकर कहीं रखना तो पड़ेगा?&lt;/span&gt;&lt;span class=&quot;&quot;&gt; आप उसे सीधे Database से GridView में नहीं डाल सकते। आपको उसे &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;RAM में लाना पड़ेगा&lt;/span&gt;&lt;span class=&quot;&quot;&gt;। RAM में Data Store करने के लिए ही &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Object&lt;/span&gt;&lt;span class=&quot;&quot;&gt; बनता है।&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;यह Object &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;&quot;अस्थायी भंडारण (Temporary Storage)&quot;&lt;/span&gt;&lt;span class=&quot;&quot;&gt; है, जो Program के चलने (Runtime) तक ही रहता है।&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr style=&quot;background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: none 100% / 1 / 0 stretch; height: 1px; margin: 32px 0px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px;&quot;&gt;&lt;h3 style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 20px; line-height: 30px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(15, 17, 21); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;3️⃣ &quot;क्या ऐसा होता है कि हमें ऑब्जेक्ट बनाने की ज़रूरत पड़ती है?&quot;&lt;/span&gt;&lt;/h3&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;100% हाँ!&lt;/span&gt;&lt;span class=&quot;&quot;&gt; आपकी .NET App में हर 5वीं लाइन पर आप ऑब्जेक्ट बनाते हैं। जब भी आप लिखते हैं:&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;margin: 16px 0px; padding-left: 18px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;li&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;List&amp;lt;Employee&amp;gt; employees = new List&amp;lt;Employee&amp;gt;();&lt;/code&gt;&lt;span class=&quot;&quot;&gt; (List ऑब्जेक्ट)&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;SqlConnection conn = new SqlConnection();&lt;/code&gt;&lt;span class=&quot;&quot;&gt; (Connection ऑब्जेक्ट)&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;EmployeeService service = new EmployeeService();&lt;/code&gt;&lt;span class=&quot;&quot;&gt; (Service ऑब्जेक्ट)&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;&quot;&gt;...तो आप ऑब्जेक्ट बना ही रहे होते हैं।&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;h3 style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 20px; line-height: 30px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(15, 17, 21); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;4️⃣ 🔥 &lt;/span&gt;&lt;span style=&quot;font-weight: inherit;&quot;&gt;आपका सबसे अहम सवाल:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; &quot;ऑब्जेक्ट की जरूरत कैसे पता चलती है? कहीं दिखता है क्या?&quot;&lt;/span&gt;&lt;/h3&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;हाँ, यह दिखता है!&lt;/span&gt;&lt;span class=&quot;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;&quot;&gt;इसे समझने के लिए आपको &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;&#39;कंपाइलर (Compiler)&#39;&lt;/span&gt;&lt;span class=&quot;&quot;&gt; की आवाज़ सुननी होगी, और &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;&#39;मेथड सिग्नेचर (Method Signature)&#39;&lt;/span&gt;&lt;span class=&quot;&quot;&gt; देखना होगा।&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;यहाँ 3 Visual Clues (सुराग) हैं जो बताते हैं कि &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;&quot;यहाँ ऑब्जेक्ट बनाओ&quot;&lt;/span&gt;&lt;span class=&quot;&quot;&gt;:&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;h4 style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 16px; line-height: 28px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 16px 0px; color: rgb(15, 17, 21); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;सुराग 1: जब कोई Method कुछ &lt;/span&gt;&lt;em&gt;Return&lt;/em&gt;&lt;span class=&quot;&quot;&gt; करता है (वापस लौटाता है)&lt;/span&gt;&lt;/h4&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;अगर आपने &lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;GetEmployee()&lt;/code&gt;&lt;span class=&quot;&quot;&gt; नाम का Function बनाया, और उसे &lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;Employee&lt;/code&gt;&lt;span class=&quot;&quot;&gt; (Class) Return करना है, तो आपको उस Function के अंदर &lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-variant: normal; font-stretch: 100%; line-height: 22px; font-optical-sizing: auto; font-size-adjust: none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans 