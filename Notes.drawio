none; font-kerning: auto; font-feature-settings: normal; font-variation-settings: normal; font-language-override: normal; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(235, 238, 242); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: 0.875em !important;&quot;&gt;new Employee()&lt;/code&gt;&lt;span class=&quot;&quot;&gt; बनाकर भेजना होगा।&lt;/span&gt;&lt;/p&gt;&lt;h4 style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 16px; line-height: 28px; font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 16px 0px; color: rgb(15, 17, 21); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;&quot;&gt;सुराग 3: जब आपको Data का एक &lt;/span&gt;&lt;span style=&quot;font-weight: inherit;&quot;&gt;&quot;समूह (Group)&quot;&lt;/span&gt;&lt;span class=&quot;&quot;&gt; एक साथ रखना हो (GridView का सीधा Connection)&lt;/span&gt;&lt;/h4&gt;&lt;p style=&quot;margin: 16px 0px; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);&quot; class=&quot;ds-markdown-paragraph&quot;&gt;&lt;span class=&quot;&quot;&gt;आपने कहा: &lt;/span&gt;&lt;em&gt;&quot;Table इसलिए बनाई क्योंकि Data को GridView में दिखाना है।&quot;&lt;/em&gt;&lt;span class=&quot;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;&quot;&gt;GridView में सिर्फ 1 Row नहीं, बल्कि 100 Rows दिखती हैं। C# में 100 Rows को एक साथ रखने के लिए &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;List (सूची)&lt;/span&gt;&lt;span class=&quot;&quot;&gt; चाहिए, और List में हर Row को रखने के लिए &lt;/span&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Object&lt;/span&gt;&lt;span class=&quot;&quot;&gt; चाहिए।&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; top: 0px; z-index: 6; background-color: rgb(255, 255, 255); border-top-left-radius: 12px; border-top-right-radius: 12px; position: sticky;&quot; class=&quot;md-code-block-banner-wrap&quot;&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background: none 0% 0% / auto repeat scroll padding-box border-box rgb(249, 250, 251); font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 13px; line-height: 20px; justify-content: space-between; padding: 0px; display: flex; border-top-left-radius: 12px; border-top-right-radius: 12px;&quot; class=&quot;md-code-block-banner md-code-block-banner-lite&quot;&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); justify-content: space-between; align-items: center; width: 740px; padding: 6px; display: flex;&quot; c