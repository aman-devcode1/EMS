ss-name&quot;&gt;Employee&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;;&lt;/span&gt; &lt;span style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot; class=&quot;token comment&quot;&gt;// ⬅️ यहाँ &#39;new&#39; दिखेगा इसलिए कि Return Type &#39;Employee&#39; है।&lt;/span&gt;&lt;br&gt;    emp&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;.&lt;/span&gt;Id &lt;span style=&quot;color: rgb(64, 120, 242);&quot; class=&quot;token operator&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(183, 107, 1);&quot; class=&quot;token number&quot;&gt;101&lt;/span&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(166, 38, 164);&quot; class=&quot;token keyword&quot;&gt;return&lt;/span&gt; emp&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;;&lt;/span&gt; &lt;br&gt;&lt;span style=&quot;color: rgb(56, 58, 66);&quot; class=&quot;token punctuation&quot;&gt;}&lt;/span&gt;&lt;/pre&gt;&lt;svg class=&quot;_9bc997d _33882ae&quot; fill=&quot;none&quot; viewBox=&quot;0 0 12 12&quot; height=&quot;12&quot; width=&quot;12&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;path fill=&quot;currentColor&quot; d=&quot;M-5.24537e-07 0C-2.34843e-07 6.62742 5.37258 12 12 12L0 12L-5.24537e-07 0Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;svg class=&quot;_9bc997d _28d7e84&quot; fill=&quot;none&quot; viewBox=&quot;0 0 12 12&quot; height=&quot;12&quot; width=&quot;12&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;path fill=&quot;currentColor&quot; d=&quot;M-5.24537e-07 0C-2.34843e-07 6.62742 5.37258 12 12 12L0 12L-5.24537e-07 0Z&quot;&gt;&